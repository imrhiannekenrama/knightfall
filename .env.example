# Vercel project -> Settings -> Environment Variables
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # NEVER expose this to the browser
APP_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SETUP_TOKEN=REPLACE_WITH_A_RANDOM_ONE_TIME_TOKEN
MESSENGER_URL=https://m.me/YOUR_FACEBOOK_PAGE
